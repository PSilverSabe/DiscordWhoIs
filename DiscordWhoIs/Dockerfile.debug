# ======================
# BUILD STAGE (Alpine SDK)
# ======================
FROM mcr.microsoft.com/dotnet/sdk:9.0-alpine AS build
WORKDIR /src

# Dependencies for building
RUN apk add --no-cache clang zlib-dev musl-dev icu-dev libgcc libstdc++ bash

# Copy csproj first (layer caching)
COPY ["DiscordWhoIs/DiscordWhoIs.csproj", "DiscordWhoIs/"]
RUN dotnet restore "DiscordWhoIs/DiscordWhoIs.csproj"

# Copy source
COPY ["DiscordWhoIs/", "DiscordWhoIs/"]
WORKDIR "/src/DiscordWhoIs"

# Publish DEBUG build (no trimming, no NativeAOT)
RUN dotnet publish DiscordWhoIs.csproj \
    -c Debug \
    -o /app/publish \
    -r linux-musl-x64 \
    /p:PublishSingleFile=false \
    /p:SelfContained=false \
    /p:PublishTrimmed=false \
    /p:DebugType=portable \
    /p:DebugSymbols=true

# ======================
# FINAL RUNTIME IMAGE (Alpine SDK for Debug)
# ======================
FROM mcr.microsoft.com/dotnet/sdk:9.0-alpine AS debug
WORKDIR /app

# Copy published files from build
COPY --from=build /app/publish/ .

# Add bash for interactive debugging
RUN apk add --no-cache bash icu-libs libgcc libstdc++ zlib

# Make entrypoint executable
RUN chmod +x DiscordWhoIs

# Start in bash for interactive debugging, default fallback to app
ENTRYPOINT ["/bin/bash", "-c", "./DiscordWhoIs"]
