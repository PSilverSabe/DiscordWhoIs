<linker>
	<assembly fullname="DiscordWhoIs">
		<!-- Preserve all slash command modules -->
		<type fullname="DiscordWhoIs.Commands.WhoIsCommandModule" preserve="all"/>
		<type fullname="DiscordWhoIs.Commands.AliasCommandModule" preserve="all"/>
		<type fullname="DiscordWhoIs.Commands.ClearCacheCommandModule" preserve="all"/>

		<!-- Preserve other InteractionModuleBase types if you add more -->
		<!--<type fullname="DiscordWhoIs.Commands.Modules.OtherCommandModule" preserve="all"/>-->
	</assembly>

	<!-- Preserve Discord.Net assemblies used by reflection -->
	<assembly fullname="Discord.Net.Interactions" preserve="all"/>
	<assembly fullname="Discord.Net.Core" preserve="all"/>
	<assembly fullname="Discord.Net.Rest" preserve="all"/>
	<assembly fullname="Discord.Net.WebSocket" preserve="all"/>
	<!-- Preserve Newtonsoft.Json for reflection -->
	<assembly fullname="Newtonsoft.Json" preserve="all"/>
	<!-- Preserve Entity Framework Core for reflection -->
	<assembly fullname="Microsoft.EntityFrameworkCore" preserve="all"/>
	<assembly fullname="Microsoft.EntityFrameworkCore.Relational" preserve="all"/>
	<assembly fullname="Microsoft.EntityFrameworkCore.Sqlite" preserve="all"/>
	<!-- Preserve Playwright for reflection-->
	<assembly fullname="Microsoft.Playwright">
		<type fullname="Microsoft.Playwright.*" preserve="all"/>
	</assembly>
	<assembly fullname="System.Text.Json">
		<type fullname="System.Text.Json.JsonSerializerOptions" preserve="all"/>
		<type fullname="System.Text.Json.JsonSerializer" preserve="all"/>
	</assembly>

</linker>
