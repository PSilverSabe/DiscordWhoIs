{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Cache": {
    "Path": "cache.sqlite",
    "FlushIntervalSeconds": 15,
    "CleanupIntervalSeconds": 45,
    "ExpirationInHours": 12
  },
  "Alias": {
    "Path": "aliases.sqlite"
  },
  "Ao3": {
    "Ao3MinimumDelayMs": 12000,
    "Ao3BackoffMs": 2000,
    "Ao3ConcurrencyLimit": 1,
    "MaxRetries": 1,
    "RetryDelayMilliseconds": 500
  }
}
