{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Cache": {
    "Path": "persistent_cache.sqlite",
    "FlushIntervalSeconds": "5",
    "CleanupIntervalSeconds": "60",
    "ExpirationInHours": "12"
  },
  "Aliases": {
    "Path": "aliases.sqlite"
  },
  "Ao3": {
    "Ao3MinimumDelayMs": 12000,
    "Ao3BackoffMs": 2000,
    "Ao3ConcurrencyLimit": 1
  }
}
