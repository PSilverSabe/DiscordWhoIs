{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "BotDbContext": {
        "TargetDirectory": "/databases",
        "FileName": "botdbcontext.sqlite"
    },
    "Upload": {
        "TargetDirectory": "/databases",
        "FileName": "fanfic_updates.json",
        "IncludeExceptionDetails": false
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "System": "Warning",
                "Discord": "Information",
                "Discord.WebSocket": "Information",
                "Microsoft.EntityFrameworkCore": "Warning",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
                "Discord.Rest": "Warning"
            }
        }
    }
}
